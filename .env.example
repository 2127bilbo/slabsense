# SlabSense environment variables. Copy to .env.local (gitignored) and fill in.
# Names only; never commit values. Vercel holds the production values.

# --- Supabase (client + API) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # API only, never in the client

# --- AI providers (API only). Only Anthropic is used for grades; the others are optional/legacy. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
REPLICATE_API_TOKEN=
SURFACE_DEDUCTION_MODEL=1             # 0 turns the TAG deduction regressor off
GRADE_ROLLUP_MODEL=0                  # 1 lets the learned rollup set the grade label (off: engine rule)
DEEP_GRADE_MODE=single                # single | parallel | sequential | synthesize (operators only)

# --- Stripe (web purchases + physical slab) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=            # SlabSense Plus, monthly allowance
STRIPE_PRICE_GRADES_5=                # 5 AI Grades pack
STRIPE_PRICE_GRADES_20=               # 20 AI Grades pack
STRIPE_PRICE_SLAB=                    # physical slab order

# --- Apple in-app purchase (iOS app) ---
APPLE_BUNDLE_ID=com.slabsense.app
APPLE_APP_APPLE_ID=                   # numeric app id from App Store Connect
APPLE_ENVIRONMENT=Production          # Sandbox while testing

# --- App ---
VITE_APP_URL=https://www.slabsenseai.com
ADMIN_USER_IDS=                       # comma-separated user ids allowed into the studio queue
VITE_MODELS_URL=                      # optional override of the models bucket base URL
VITE_MODEL_GRADING=                   # optional build default for the on-device models switch
